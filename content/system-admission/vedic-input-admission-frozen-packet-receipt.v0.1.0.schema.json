        },
        "transitionContractDigest": {
          "const": "548a0ab95dbe030dda2c158a7a4583c4591d98be75bc9f9a604ff98cff3d52ac"
        },
        "upstreamReadinessCandidateDigest": {
          "const": "688a786525d8d8c988be2d517d31cca23113d788cadc3168cae5bbd71a6a1efb"
        },
        "validatorProfileSetDigest": {
          "$ref": "#/$defs/sha256"
        }
