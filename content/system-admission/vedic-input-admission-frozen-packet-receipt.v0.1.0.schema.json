  },
  "x-hakimiBoundary": {
    "acceptedReceipt": false,
    "artifactRole": "isolated_vedic_draft_transition_candidate_schema",
    "authorityEffect": "none",
    "candidateOnly": true,
    "commitObserved": false,
    "countsTowardFormalAdmission": false,
    "expertClaimsAuthorized": false,
    "formalAdmissionAuthorized": false,
    "issuedReceipt": false,
    "independentProductIdentityEstablished": false,
    "mutationEpochRuntimeEstablished": false,
    "persistedReceipt": false,
    "publicDeploymentAuthorized": false,
    "publicReleaseAuthorized": false,
    "releaseReady": false
  },
  "x-hakimiReviewContentDigestFields": [
    "selectedValueSetDigest",
    "targetUseProfileDigest",
    "questionSetDigest",
    "sourceBindingManifestDigest",
    "threeLayerRightsEvidenceManifestDigest",
    "validatorProfileSetDigest",
    "privateLifecyclePolicyDigest",
    "distributionOperationSetDigest",
    "targetJurisdictionSetDigest",
    "reviewInstructionAndDisagreementPolicyDigest"
  ],
  "x-hakimiEvaluatorInvariants": {
    "enforcedBy": "evaluateVedicInputAdmissionTransition and parseCanonicalVedicGovernancePacket",
    "jsonSchemaAloneProvesCrossFieldEquality": false,
    "rules": [
      "afterEpoch equals beforeEpoch plus one only in the returned draft candidate calculation; mutationEpochRuntimeEstablished remains false and no commit is observed",
      "packet admissionCycleId and packetId suffixes equal packetManifestDigest",
      "candidateReceipt packetDigest, packetId, and packetManifestDigest equal the corresponding packet fields",
      "nextRevocationLedgerHeadDigest equals previousRevocationLedgerHeadDigest",
      "all packet set, manifest, privacy, receipt, state, nonce-head, and chain-head digests are domain-separated evaluator recomputations"
    ]
  }
}
