{
  "fixtureVersion": "1.0.0",
  "datasetId": "hko-calendar-conversion-candidates-v1",
  "title": "首批 24 条公历与农历双向转换权威历表候选",
  "notice": "每条期望值均人工选自香港天文台公历与农历日期对照表，并冻结来源材料摘要；当前尚无双人裁决，全部保持 candidate，不能增加 verifiedGoldCaseCount。",
  "frame": "fixed_plus08_lunisolar_date",
  "requiredCalendarGoldCaseCount": 24,
  "requiredProjectGoldCaseCount": 360,
  "reviewPolicy": {
    "lifecycleVersion": "candidate-only-v1",
    "verifiedCountingEnabled": false,
    "notice": "内容寻址审核包与绑定具体审核包的双人裁决预检已经实现；预检不持久化、不自动升级，真实双人裁决尚未纳入新版本 fixture 前，Schema 禁止任何案例进入 verified。"
  },
  "sourceLandingPage": "https://www.hko.gov.hk/en/gts/time/conversion.htm",
  "openDataDataset": "https://data.gov.hk/en-data/dataset/hk-hko-rss-gregorian-lunar-calendar-conversion-table",
  "reuseTerms": "https://data.gov.hk/en/terms-and-conditions",
  "knownCaveats": [
    "香港天文台说明：远期月相与节气计算存在分钟级不确定性；若朔或节气接近午夜，相关日期可能相差一天。",
    "香港天文台列出的已知新月日期风险点为 2057-09-28、2089-09-04、2097-08-07；本批 24 条未选用这些日期。",
    "来源材料与被测 lunar-typescript 不同谱系，但在完成两个真实复核身份的逐条裁决前仍不计为 verified 金标。"
  ],
