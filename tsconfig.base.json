{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "node"],
    "paths": {
      "@hakimi/contracts": ["./packages/contracts/src/index.ts"],
      "@hakimi/backup": ["./packages/backup/src/index.ts"],
      "@hakimi/case-import": ["./packages/case-import/src/index.ts"],
      "@hakimi/chart-integrity": ["./packages/chart-integrity/src/index.ts"],
      "@hakimi/revision-replay": ["./packages/revision-replay/src/index.ts"],
      "@hakimi/comparison-core": ["./packages/comparison-core/src/index.ts"],
      "@hakimi/integrity": ["./packages/integrity/src/index.ts"],
      "@hakimi/rule-profiles": ["./packages/rule-profiles/src/index.ts"],
      "@hakimi/bazi-core": ["./packages/bazi-core/src/index.ts"],
      "@hakimi/gold-standard/calendar-divergence-windows": ["./packages/gold-standard/src/calendar-divergence-windows.ts"],
      "@hakimi/gold-standard/calendar-divergence-review": ["./packages/gold-standard/src/calendar-divergence-review.ts"],
      "@hakimi/gold-standard/lunar-conversion": ["./packages/gold-standard/src/lunar-conversion.ts"],
      "@hakimi/gold-standard/release-gate": ["./packages/gold-standard/src/release-gate.ts"],
      "@hakimi/gold-standard/p0-03-differential": ["./packages/gold-standard/src/p0-03-differential.ts"],
      "@hakimi/gold-standard/p0-03-report": ["./packages/gold-standard/src/p0-03-report.ts"],
      "@hakimi/gold-standard/p0-03-summary": ["./packages/gold-standard/reports/p0-03-engineering-diagnostic-summary.v1.json"],
      "@hakimi/gold-standard": ["./packages/gold-standard/src/index.ts"],
      "@hakimi/luck-core": ["./packages/luck-core/src/index.ts"],
      "@hakimi/relations-core": ["./packages/relations-core/src/index.ts"],
      "@hakimi/time-core": ["./packages/time-core/src/index.ts"],
      "@hakimi/tzdb-core": ["./packages/tzdb-core/src/index.ts"],
      "@hakimi/transit-core": ["./packages/transit-core/src/index.ts"],
      "@hakimi/storage": ["./packages/storage/src/index.ts"],
      "@hakimi/research-export": ["./packages/research-export/src/index.ts"],
      "@hakimi/research-query/transit-review": ["./packages/research-query/src/transit-review.ts"],
      "@hakimi/research-query": ["./packages/research-query/src/index.ts"],
      "@hakimi/rule-packs": ["./packages/rule-packs/src/index.ts"],
      "@hakimi/platform": ["./packages/platform/src/index.ts"],
      "@hakimi/knowledge-core": ["./packages/knowledge-core/src/index.ts"]
    }
  }
}
