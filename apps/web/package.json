{
  "name": "@hakimi/web",
  "version": "0.2.0-p0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:production-v14": "vite build --config vite.production-v14.config.ts",
    "build:production-v15:candidate": "vite build --config vite.production-v15.config.ts",
    "build:production-v13-to-v15:candidate": "vite build --config vite.production-v13-to-v15.config.ts",
    "build:production-v13-to-v16:candidate": "vite build --config vite.production-v13-to-v16.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "preview:e2e": "vite preview --config vite.e2e.config.ts",
    "serve:e2e": "npm run build:e2e && npm run preview:e2e",
    "preview:e2e:v15": "vite preview --config vite.production-v15.config.ts --host 127.0.0.1 --port 4198 --strictPort",
    "serve:e2e:v15": "npm run build:production-v15:candidate && npm run preview:e2e:v15",
    "preview:e2e:v13-to-v15": "vite preview --config vite.production-v13-to-v15.config.ts --host 127.0.0.1 --port 4199 --strictPort",
    "serve:e2e:v13-to-v15": "npm run build:production-v13-to-v15:candidate && npm run preview:e2e:v13-to-v15",
    "preview:e2e:v13-to-v16": "vite preview --config vite.production-v13-to-v16.config.ts --host 127.0.0.1 --port 4200 --strictPort",
    "serve:e2e:v13-to-v16": "npm run build:production-v13-to-v16:candidate && npm run preview:e2e:v13-to-v16"
  },
  "dependencies": {
    "@hakimi/backup": "*",
    "@hakimi/bazi-core": "*",
    "@hakimi/case-import": "*",
    "@hakimi/comparison-core": "*",
    "@hakimi/contracts": "*",
    "@hakimi/gold-standard": "*",
    "@hakimi/integrity": "*",
    "@hakimi/knowledge-core": "*",
    "@hakimi/luck-core": "*",
    "@hakimi/platform": "*",
    "@hakimi/relations-core": "*",
    "@hakimi/revision-replay": "*",
    "@hakimi/research-query": "*",
    "@hakimi/research-export": "*",
    "@hakimi/rule-packs": "*",
    "@hakimi/rule-profiles": "*",
    "@hakimi/storage": "*",
    "@hakimi/time-core": "*",
    "@hakimi/transit-core": "*",
    "dexie": "4.4.4",
    "html-to-image": "1.11.13",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.6"
  }
}
