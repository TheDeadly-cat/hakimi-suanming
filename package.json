    "test:e2e:event-time:migration": "playwright test --config apps/web/playwright.config.ts event-time-migration.spec.ts",
    "test:e2e:pwa": "playwright test --config apps/web/playwright.config.ts pwa-install-and-offline-cold-start.spec.ts",
    "test:e2e:privacy-clear": "playwright test --config apps/web/playwright.config.ts privacy-clear-all-data.spec.ts",
    "test:e2e:capacity": "playwright test --config apps/web/playwright.config.ts case-library-capacity.spec.ts",
    "test:e2e:sw-upgrade": "playwright test --config apps/web/playwright.sw-upgrade.config.ts",
    "test:e2e:cross-schema-upgrade": "playwright test --config apps/web/playwright.cross-schema-upgrade.config.ts",
    "test:e2e:cross-schema-v13-v15": "playwright test --config apps/web/playwright.cross-schema-v13-v15.config.ts",
    "test:e2e:cross-schema-v13-v16": "playwright test --config apps/web/playwright.cross-schema-v13-v16.config.ts",
    "test:e2e:schema-v16-clean-start-capacity": "playwright test --config apps/web/playwright.schema-v16-clean-start-capacity.config.ts --project=msedge",
