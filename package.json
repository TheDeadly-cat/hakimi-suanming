    "test:e2e:web-v1-flow": "playwright test --config apps/web/playwright.web-v1-cross-browser.config.ts",
    "test:e2e:web-v1-flow:v15": "playwright test --config apps/web/playwright.web-v1-v15-cross-browser.config.ts",
    "test:e2e:web-v1-flow:v13-to-v15": "playwright test --config apps/web/playwright.web-v1-v13-to-v15-cross-browser.config.ts",
    "test:e2e:web-v1-flow:v13-to-v16": "playwright test --config apps/web/playwright.web-v1-v13-to-v16-cross-browser.config.ts",
    "test:e2e:p2-05-deep-browse": "playwright test --config apps/web/playwright.config.ts p2-05-deep-browse-resource.spec.ts",
    "test:e2e:p2-05-heavy-browser-gate": "playwright test --config apps/web/playwright.p2-05-heavy.config.ts --project=msedge",
    "test:e2e:bazi-current-chart-review": "playwright test --config apps/web/playwright.bazi-current-chart-review.config.ts",
    "test:e2e:ziwei-v013": "playwright test --config packages/ziwei-workspace-artifact-draft/playwright.v013.config.ts",
    "test:e2e:ziwei-workspace": "playwright test --config packages/ziwei-workspace-artifact-draft/playwright.workspace.config.ts",
    "test:e2e:western-rules-preview": "playwright test --config packages/western-astrology-rules-preview-draft/playwright.rules-preview.config.ts",
    "test:e2e:cross-system-preview": "playwright test --config packages/cross-system-comparison-draft/playwright.preview.config.ts",
    "test:gold": "vitest run --config apps/web/vitest.config.ts packages/gold-standard/src",
    "test:transit-query-review": "vitest run --config apps/web/vitest.config.ts packages/research-query/src/transit-review.test.ts",
    "audit:tzdb": "node packages/tzdb-core/scripts/verify-artifact.mjs",
    "test:tzdb": "node packages/tzdb-core/scripts/run-release-gate.mjs",
    "test:comparison-golden": "node packages/comparison-core/scripts/update-formal-comparison-golden.mjs --check",
    "update:comparison-golden": "node packages/comparison-core/scripts/update-formal-comparison-golden.mjs --write",
    "deps:audit": "node scripts/generate-dependency-audit.mjs --check",
    "deps:audit:update": "node scripts/generate-dependency-audit.mjs --write",
    "audit:calendar:dotnet": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/gold-standard/scripts/check-dotnet-calendar.ps1",
    "audit:p0-03:differential": "node packages/gold-standard/scripts/run-p0-03-differential.mjs --check",
    "audit:p0-03:calendar-windows": "node packages/gold-standard/scripts/audit-calendar-divergence-windows.mjs",
    "test:audit:p0-03:calendar-windows": "node packages/gold-standard/scripts/audit-calendar-divergence-windows.mjs --self-test",
    "update:p0-03:differential": "node packages/gold-standard/scripts/run-p0-03-differential.mjs --write",
    "test:watch": "vitest --config apps/web/vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
