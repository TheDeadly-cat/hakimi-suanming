    "preview:ziwei-browser-preview": "node apps/web/node_modules/vite/bin/vite.js preview --config packages/ziwei-iztro-adapter-draft/vite.browser-preview.config.mjs --configLoader runner --host 127.0.0.1 --port 4216 --strictPort",
    "prebuild:ziwei-browser-workspace": "npm run check:system-contract-draft-boundaries",
    "build:ziwei-browser-workspace": "node apps/web/node_modules/vite/bin/vite.js build --config packages/ziwei-workspace-artifact-draft/vite.browser-app.config.mjs --configLoader runner",
    "prepreview:ziwei-browser-workspace": "npm run build:ziwei-browser-workspace",
    "preview:ziwei-browser-workspace": "node apps/web/node_modules/vite/bin/vite.js preview --config packages/ziwei-workspace-artifact-draft/vite.browser-app.config.mjs --configLoader runner --host 127.0.0.1 --port 4218 --strictPort",
    "prebuild:western-browser-parity": "npm run check:system-contract-draft-boundaries",
