{
  "name": "hakimi-bazi-workbench",
  "version": "0.2.0-p0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:system-contract-draft-boundaries": "node scripts/verify-system-contract-draft-boundaries.mjs",
    "test:system-contract-draft-boundaries": "node --test scripts/verify-system-contract-draft-boundaries.test.mjs",
    "typecheck:system-contract-drafts": "npm run check:system-contract-draft-boundaries && tsc --noEmit -p packages/ziwei-doushu-contracts-draft/tsconfig.json && tsc --noEmit -p packages/ziwei-iztro-adapter-draft/tsconfig.json && tsc --noEmit -p packages/ziwei-iztro-adapter-draft/tsconfig.browser-preview.json && tsc --noEmit -p packages/ziwei-fortel-differential-draft/tsconfig.json && tsc --noEmit -p packages/ziwei-workspace-artifact-draft/tsconfig.json && tsc --noEmit -p packages/ziwei-workspace-artifact-draft/tsconfig.browser-app.json && tsc --noEmit -p packages/western-astrology-contracts-draft/tsconfig.json && tsc --noEmit -p packages/western-astronomy-engine-adapter-draft/tsconfig.json && tsc --noEmit -p packages/western-astronomy-engine-adapter-draft/tsconfig.browser-parity.json && tsc --noEmit -p packages/western-astrology-rules-preview-draft/tsconfig.json && tsc --noEmit -p packages/western-astrology-rules-preview-draft/tsconfig.browser-app.json",
