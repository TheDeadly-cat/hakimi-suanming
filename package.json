    "prepreview:western-browser-parity": "npm run build:western-browser-parity",
    "preview:western-browser-parity": "node apps/web/node_modules/vite/bin/vite.js preview --config packages/western-astronomy-engine-adapter-draft/vite.browser-parity.config.mjs --configLoader runner --host 127.0.0.1 --port 4217 --strictPort",
    "prebuild:western-rules-preview": "npm run check:system-contract-draft-boundaries",
    "build:western-rules-preview": "node apps/web/node_modules/vite/bin/vite.js build --config packages/western-astrology-rules-preview-draft/vite.rules-preview.config.mjs --configLoader runner",
    "prepreview:western-rules-preview": "npm run build:western-rules-preview",
    "preview:western-rules-preview": "node apps/web/node_modules/vite/bin/vite.js preview --config packages/western-astrology-rules-preview-draft/vite.rules-preview.config.mjs --configLoader runner --host 127.0.0.1 --port 4219 --strictPort",
    "build:cross-system-browser-preview": "node apps/web/node_modules/vite/bin/vite.js build --config packages/cross-system-comparison-draft/vite.browser-preview.config.mjs --configLoader runner",
    "prepreview:cross-system-browser-preview": "npm run build:cross-system-browser-preview",
    "preview:cross-system-browser-preview": "node apps/web/node_modules/vite/bin/vite.js preview --config packages/cross-system-comparison-draft/vite.browser-preview.config.mjs --configLoader runner --host 127.0.0.1 --port 4220 --strictPort",
    "audit:ziwei:official-calendar": "node packages/ziwei-iztro-adapter-draft/scripts/audit-hko-calendar-boundary-matrix.ts",
    "demo:ziwei:fortel": "node packages/ziwei-fortel-differential-draft/src/demo.ts",
    "demo:ziwei:workspace": "node packages/ziwei-workspace-artifact-draft/src/demo.ts",
    "demo:western:astronomy": "node packages/western-astronomy-engine-adapter-draft/src/demo.ts",
    "demo:western:rules": "node packages/western-astronomy-engine-adapter-draft/src/rule-layer/demo.ts",
    "demo:western:horizons": "node packages/western-astronomy-engine-adapter-draft/src/horizons-differential/demo.ts",
