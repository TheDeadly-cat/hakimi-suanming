{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakimi.invalid/schemas/deployed-host-http-receipt-candidate-v1.json",
  "title": "Hakimi deployed host HTTP receipt candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptType",
    "receiptId",
    "trustClass",
    "status",
    "verificationKind",
    "observationSource",
    "candidatePlatform",
    "targetOrigin",
    "checkedPolicy",
    "releaseEvidenceId",
    "artifactSetDigest",
    "buildVersion",
    "descriptor",
    "networkCompleted",
    "candidateContractObserved",
    "syntheticContractMatched",
    "artifactSnapshotStable",
    "attachments",
    "rawAttachmentSetDigest",
    "authorizationBoundary",
    "claims",
    "receiptDigest",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptType": { "const": "deployed_host_http_receipt_candidate_v1" },
    "receiptId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}-host$" },
    "trustClass": { "const": "untrusted_candidate" },
    "status": { "const": "not_admitted" },
    "verificationKind": {
      "enum": [
        "real-network-candidate-observation",
        "synthetic-offline-candidate-contract"
      ]
    },
    "observationSource": {
      "enum": [
        "node_http_pinned_real_network_v1",
        "synthetic_injected_test_fixture"
      ]
    },
    "candidatePlatform": { "type": "string", "pattern": "^(?!unselected$)[a-z0-9][a-z0-9._-]{0,63}$" },
    "targetOrigin": { "$ref": "#/$defs/Origin" },
    "checkedPolicy": { "$ref": "#/$defs/CheckedPolicy" },
    "releaseEvidenceId": { "$ref": "#/$defs/EvidenceId" },
    "artifactSetDigest": { "$ref": "#/$defs/Sha256" },
    "buildVersion": { "$ref": "#/$defs/BuildVersion" },
    "descriptor": { "$ref": "#/$defs/DefaultDescriptor" },
    "networkCompleted": { "type": "boolean" },
    "candidateContractObserved": { "type": "boolean" },
    "syntheticContractMatched": { "type": "boolean" },
    "artifactSnapshotStable": { "const": true },
    "attachments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Attachment" }
    },
    "rawAttachmentSetDigest": { "$ref": "#/$defs/Sha256" },
    "authorizationBoundary": { "$ref": "#/$defs/AuthorizationBoundary" },
    "claims": { "$ref": "#/$defs/Claims" },
    "receiptDigest": { "$ref": "#/$defs/Sha256" },
    "startedAt": { "$ref": "#/$defs/Timestamp" },
    "completedAt": { "$ref": "#/$defs/Timestamp" }
  },
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "EvidenceId": { "type": "string", "pattern": "^hre1-[a-f0-9]{32}$" },
    "BuildVersion": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Origin": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+$", "maxLength": 256 },
    "BindingPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "maxLength": 512
    },
    "Attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "size", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "artifact-initial",
            "http-observations",
            "artifact-final"
          ]
        },
        "path": { "$ref": "#/$defs/BindingPath" },
        "size": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "CheckedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "deploymentPlatform", "canonicalOrigin", "byteSha256", "canonicalSha256"],
      "properties": {
        "policyId": { "const": "hakimi-web-public-hosting-baseline-v2" },
        "deploymentPlatform": { "const": "unselected" },
        "canonicalOrigin": { "const": null },
        "byteSha256": { "$ref": "#/$defs/Sha256" },
        "canonicalSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "DefaultDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "dbGeneration",
        "databaseName",
        "targetSchema",
        "minReadableSchema",
        "maxReadableSchema",
        "migrationId",
        "acceptedCommittedMigrationIds",
        "sourceGeneration",
        "sourceDatabaseName",
        "sourceSchema"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "dbGeneration": { "const": "legacy-v13" },
        "databaseName": { "const": "hakimi-bazi-research" },
        "targetSchema": { "const": 13 },
        "minReadableSchema": { "const": 13 },
        "maxReadableSchema": { "const": 13 },
        "migrationId": { "const": null },
        "acceptedCommittedMigrationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": null }
        },
        "sourceGeneration": { "const": null },
        "sourceDatabaseName": { "const": null },
        "sourceSchema": { "const": null }
      }
    },
    "AuthorizationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalDeploymentExecutionAuthorized",
        "publicDeploymentAuthorized",
        "publicReleaseAuthorized",
        "authorizationMayNotBeDerivedFromCandidateEvidence"
      ],
      "properties": {
        "externalDeploymentExecutionAuthorized": { "const": false },
        "publicDeploymentAuthorized": { "const": false },
        "publicReleaseAuthorized": { "const": false },
        "authorizationMayNotBeDerivedFromCandidateEvidence": { "const": true }
      }
    },
    "Claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realHostVerified",
        "deploymentOperationObserved",
        "publicDeploymentAuthorized",
        "publicReleaseAuthorized",
        "releaseReady",
        "contentTruthAuthorized",
        "expertClaimsAuthorized",
        "rightsLegalConclusionAuthorized"
      ],
      "properties": {
        "realHostVerified": { "const": false },
        "deploymentOperationObserved": { "const": false },
        "publicDeploymentAuthorized": { "const": false },
        "publicReleaseAuthorized": { "const": false },
        "releaseReady": { "const": false },
        "contentTruthAuthorized": { "const": false },
        "expertClaimsAuthorized": { "const": false },
        "rightsLegalConclusionAuthorized": { "const": false }
      }
    }
  }
}
