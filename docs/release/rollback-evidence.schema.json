        "approvedCopyClass": {
          "enum": [
            "owner_approved_read_only_v13_copy",
            "approved_deidentified_v13_copy"
          ]
        },
        "copyId": { "$ref": "#/$defs/canonicalId" },
        "databaseName": { "const": "hakimi-bazi-research" },
        "sourceSchema": { "const": 13 },
        "epochSupport": { "const": "absent_schema13" },
        "epochBefore": { "const": null },
        "epochAfter": { "const": null },
        "rawIndexedDbBypassUsed": { "const": false },
        "mutationEpochBypassed": { "const": false },
        "releaseControlPointerModified": { "const": false },
