        "approval": { "$ref": "#/$defs/approvalBinding" },
        "fingerprint": { "$ref": "#/$defs/fingerprintBinding" }
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "acceptor", "dataOwnerApprover"],
      "properties": {
        "operator": { "$ref": "#/$defs/operatorActor" },
        "acceptor": { "$ref": "#/$defs/acceptorActor" },
        "dataOwnerApprover": { "$ref": "#/$defs/dataOwnerApproverActor" }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "browsers", "deployments"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate", "rollbackObserved"],
          "properties": {
            "baseline": { "$ref": "#/$defs/hostReceiptBinding" },
            "candidate": { "$ref": "#/$defs/hostReceiptBinding" },
            "rollbackObserved": { "$ref": "#/$defs/hostReceiptBinding" }
          }
        },
        "browsers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/browserReceiptBinding" }
        },
        "deployments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "rollbackObserved"],
          "properties": {
            "candidate": { "$ref": "#/$defs/deploymentReceiptBinding" },
            "rollbackObserved": { "$ref": "#/$defs/deploymentReceiptBinding" }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyBindingsVerified",
        "artifactLocksVerified",
        "artifactPairDistinct",
        "baselineIdentityVerified",
        "candidateIdentityVerified",
        "rollbackObservedMatchesBaseline",
        "phaseOrderVerified",
        "realHostVerified",
        "hostReceiptsVerified",
        "chromeEdgeVerified",
        "deploymentReceiptsVerified",
        "serviceWorkerControllerRestored",
        "privateDataApprovalVerified",
        "sourceV13FingerprintUnchanged",
        "mutationBoundaryPreserved",
        "actorAttestationsVerified",
        "operatorAcceptorIndependent",
        "allRequiredReceiptsPassed",
        "terminalStatusPassed",
        "rollbackEngineeringGatePassed"
      ],
      "properties": {
        "policyBindingsVerified": { "type": "boolean" },
        "artifactLocksVerified": { "type": "boolean" },
        "artifactPairDistinct": { "type": "boolean" },
        "baselineIdentityVerified": { "type": "boolean" },
        "candidateIdentityVerified": { "type": "boolean" },
        "rollbackObservedMatchesBaseline": { "type": "boolean" },
        "phaseOrderVerified": { "type": "boolean" },
        "realHostVerified": { "type": "boolean" },
        "hostReceiptsVerified": { "type": "boolean" },
        "chromeEdgeVerified": { "type": "boolean" },
        "deploymentReceiptsVerified": { "type": "boolean" },
        "serviceWorkerControllerRestored": { "type": "boolean" },
        "privateDataApprovalVerified": { "type": "boolean" },
        "sourceV13FingerprintUnchanged": { "type": "boolean" },
        "mutationBoundaryPreserved": { "type": "boolean" },
        "actorAttestationsVerified": { "type": "boolean" },
        "operatorAcceptorIndependent": { "type": "boolean" },
        "allRequiredReceiptsPassed": { "type": "boolean" },
        "terminalStatusPassed": { "type": "boolean" },
        "rollbackEngineeringGatePassed": { "type": "boolean" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineeringEvidenceOnly",
        "rollbackExecutionEvidenceOnly",
        "codeSignature",
        "expertSignature",
        "expertClaimsAuthorized",
        "contentRightsGrant",
        "dataRedistributionGrant",
        "rollbackAuthorizationGranted",
        "publicDeploymentAuthorized",
        "publicReleaseAuthorized"
      ],
      "properties": {
        "engineeringEvidenceOnly": { "const": true },
        "rollbackExecutionEvidenceOnly": { "const": true },
        "codeSignature": { "const": false },
        "expertSignature": { "const": false },
        "expertClaimsAuthorized": { "const": false },
        "contentRightsGrant": { "const": false },
        "dataRedistributionGrant": { "const": false },
        "rollbackAuthorizationGranted": { "const": false },
        "publicDeploymentAuthorized": { "const": false },
        "publicReleaseAuthorized": { "const": false }
      }
    },
    "failure": {
      "anyOf": [
        { "$ref": "#/$defs/failureRecord" },
        { "type": "null" }
      ]
    },
    "evidenceDigest": { "$ref": "#/$defs/sha256" }
  }
