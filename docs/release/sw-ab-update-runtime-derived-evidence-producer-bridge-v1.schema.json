{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakimi.invalid/schemas/sw-ab-update-runtime-derived-evidence-producer-bridge-v1.json",
  "title": "SW A/B update derived runtime evidence producer bridge publication v1",
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "RunId": { "type": "string", "pattern": "^run-[a-f0-9]{64}$" },
    "AttemptId": { "type": "string", "pattern": "^attempt-[a-f0-9]{64}$" },
    "ReleaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "dbGeneration", "targetSchema", "migrationId"],
      "properties": {
        "channel": { "const": "default-v13" },
        "dbGeneration": { "const": "legacy-v13" },
        "targetSchema": { "const": 13 },
        "migrationId": { "type": "null" }
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationEpochCapability", "epoch"],
      "properties": {
        "mutationEpochCapability": { "const": "absent_schema13" },
        "epoch": { "type": "null" }
      }
    },
    "FileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "SourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "size", "rawSha256", "canonicalSha256"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^docs/release/[A-Za-z0-9._-]+\\.json$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "rawSha256": { "$ref": "#/$defs/Sha256" },
        "canonicalSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "TupleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "projectName", "phase", "slot", "path", "size", "sha256", "recordDigest"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 8 },
        "projectName": { "enum": ["msedge", "chrome"] },
        "phase": { "enum": ["initial-a", "post-claim"] },
        "slot": { "enum": ["retained-old-a", "reload-to-b"] },
        "path": { "type": "string", "pattern": "^0[1-8]-(msedge|chrome)-.+\\.json$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "recordDigest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "IssuanceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "attemptId", "issuanceId", "receiptDigest", "marker", "receipt"],
      "properties": {
        "runId": { "$ref": "#/$defs/RunId" },
        "attemptId": { "$ref": "#/$defs/AttemptId" },
        "issuanceId": { "type": "string", "pattern": "^swabci1-[a-f0-9]{32}$" },
        "receiptDigest": { "$ref": "#/$defs/Sha256" },
        "marker": { "$ref": "#/$defs/FileBinding" },
        "receipt": { "$ref": "#/$defs/FileBinding" }
      }
    },
    "TranscriptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativeDirectory", "manifest", "bundleId", "bundleDigest", "derivedEvidenceDigest", "tupleBindings"],
      "properties": {
        "relativeDirectory": { "const": "api-transcript" },
        "manifest": { "$ref": "#/$defs/FileBinding" },
        "bundleId": { "type": "string", "pattern": "^swabapi1-[a-f0-9]{32}$" },
        "bundleDigest": { "$ref": "#/$defs/Sha256" },
        "derivedEvidenceDigest": { "$ref": "#/$defs/Sha256" },
        "tupleBindings": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/TupleBinding" }
        }
      }
    },
    "DerivedEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "rawSha256", "canonicalSha256", "semanticDigest"],
      "properties": {
        "path": { "const": "01-derived-runtime-client-capture.json" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "rawSha256": { "$ref": "#/$defs/Sha256" },
        "canonicalSha256": { "$ref": "#/$defs/Sha256" },
        "semanticDigest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "PublicationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuanceFilesHeldAcrossPendingRootMaterialization",
        "issuanceFilesHeldAcrossTerminalCommit",
        "issuanceTerminalRereadCompletedBeforeTerminalCommit",
        "bridgeOwnContractSourcesHeldAcrossTerminalCommit",
        "allEightContractSourcesHeldAcrossTerminalCommit",
        "allEightContractSourcesTerminalRereadCompletedBeforeTerminalCommit",
        "completePendingSetVerifiedBeforeRootRename",
        "sameParentPendingRootRenameCompleted",
        "finalPendingSetVerifiedBeforeTerminalCommit",
        "derivedDocumentProjectionAndDigestTripleMatched",
        "terminalCommitMarkerBoundToPublicationDigest",
        "terminalCommitMarkerPublishedLastBySameDirectoryRename",
        "publicLoaderRequiresTerminalCommitMarker",
        "businessOutputHandlesHeldAcrossTerminalCommit",
        "pendingCommitMarkerHandleHeldAcrossRename",
        "postTerminalCommitThrowingWorkAbsent",
        "allEvidenceFilesContinuouslyHeldAcrossCaptureAndPublication",
        "crashDurabilityVerified",
        "concurrentReaderSnapshotIsolationVerified"
      ],
      "properties": {
        "issuanceFilesHeldAcrossPendingRootMaterialization": { "const": true },
        "issuanceFilesHeldAcrossTerminalCommit": { "const": false },
        "issuanceTerminalRereadCompletedBeforeTerminalCommit": { "const": true },
        "bridgeOwnContractSourcesHeldAcrossTerminalCommit": { "const": true },
        "allEightContractSourcesHeldAcrossTerminalCommit": { "const": false },
        "allEightContractSourcesTerminalRereadCompletedBeforeTerminalCommit": { "const": true },
        "completePendingSetVerifiedBeforeRootRename": { "const": true },
        "sameParentPendingRootRenameCompleted": { "const": true },
        "finalPendingSetVerifiedBeforeTerminalCommit": { "const": true },
        "derivedDocumentProjectionAndDigestTripleMatched": { "const": true },
        "terminalCommitMarkerBoundToPublicationDigest": { "const": true },
        "terminalCommitMarkerPublishedLastBySameDirectoryRename": { "const": true },
        "publicLoaderRequiresTerminalCommitMarker": { "const": true },
        "businessOutputHandlesHeldAcrossTerminalCommit": { "const": true },
        "pendingCommitMarkerHandleHeldAcrossRename": { "const": false },
        "postTerminalCommitThrowingWorkAbsent": { "const": true },
        "allEvidenceFilesContinuouslyHeldAcrossCaptureAndPublication": { "const": false },
        "crashDurabilityVerified": { "const": false },
        "concurrentReaderSnapshotIsolationVerified": { "const": false }
      }
    },
    "MutationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuousMutationEpochVerified", "samePermissionMutationExcluded", "intervalMutationExcluded", "abaExcluded", "mutationEpochCapability", "epoch"],
      "properties": {
        "continuousMutationEpochVerified": { "const": false },
        "samePermissionMutationExcluded": { "const": false },
        "intervalMutationExcluded": { "const": false },
        "abaExcluded": { "const": false },
        "mutationEpochCapability": { "const": "absent_schema13" },
        "epoch": { "type": "null" }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustedImmutableProducerVerified", "callerSuppliedPageAuthenticityVerified", "runtimeCollectorProvenanceVerified", "browserObjectIssuanceAuthenticityVerified", "browserBinaryProvenanceVerified", "browserTransportAuthenticityVerified", "realBrowserExecutionVerified", "realHttpsHostVerified", "externalIssuerIdentityVerified", "attemptFreshnessExternallyVerified", "bundleReplayResistanceVerified", "publicRedistributionAuthorized"],
      "properties": {
        "trustedImmutableProducerVerified": { "const": false },
        "callerSuppliedPageAuthenticityVerified": { "const": false },
        "runtimeCollectorProvenanceVerified": { "const": false },
        "browserObjectIssuanceAuthenticityVerified": { "const": false },
        "browserBinaryProvenanceVerified": { "const": false },
        "browserTransportAuthenticityVerified": { "const": false },
        "realBrowserExecutionVerified": { "const": false },
        "realHttpsHostVerified": { "const": false },
        "externalIssuerIdentityVerified": { "const": false },
        "attemptFreshnessExternallyVerified": { "const": false },
        "bundleReplayResistanceVerified": { "const": false },
        "publicRedistributionAuthorized": { "const": false }
      }
    },
    "Authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultV13ReceiptAllowlistMember", "formalReleaseEvidenceReceipt", "trustedProviderVerified", "trustedHostVerified", "trustedBrowserRuntimeVerified", "deploymentReady", "releaseReady", "externalDeploymentExecutionAuthorized", "publicDeploymentAuthorized", "publicReleaseAuthorized", "contentTruthAuthorized", "expertClaimsAuthorized", "rightsLegalConclusionAuthorized", "schemaPromotionAuthorized"],
      "properties": {
        "defaultV13ReceiptAllowlistMember": { "const": false },
        "formalReleaseEvidenceReceipt": { "const": false },
        "trustedProviderVerified": { "const": false },
        "trustedHostVerified": { "const": false },
        "trustedBrowserRuntimeVerified": { "const": false },
        "deploymentReady": { "const": false },
        "releaseReady": { "const": false },
        "externalDeploymentExecutionAuthorized": { "const": false },
        "publicDeploymentAuthorized": { "const": false },
        "publicReleaseAuthorized": { "const": false },
        "contentTruthAuthorized": { "const": false },
        "expertClaimsAuthorized": { "const": false },
        "rightsLegalConclusionAuthorized": { "const": false },
        "schemaPromotionAuthorized": { "const": false }
      }
    },
    "Attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkAttempted", "browserAttempted", "deploymentAttempted", "rollbackAttempted", "gitAttempted"],
      "properties": {
        "networkAttempted": { "const": false },
        "browserAttempted": { "const": false },
        "deploymentAttempted": { "const": false },
        "rollbackAttempted": { "const": false },
        "gitAttempted": { "const": false }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "producerBridgeStatus",
    "evidenceClass",
    "trustClass",
    "status",
    "executionAdmission",
    "usableForRuntimeEvidence",
    "usableForCandidateAssembly",
    "formalReleaseEvidenceReceipt",
    "strictGatePassed",
    "runtimeAdmissionPassed",
    "admissionPassed",
    "usableForAdmission",
    "publishedAt",
    "releaseIdentity",
    "capabilities",
    "issuanceBinding",
    "transcriptBinding",
    "derivedEvidenceBinding",
    "sourceBindings",
    "sourceSetDigest",
    "publicationBoundary",
    "mutationBoundary",
    "provenance",
    "authority",
    "attempts",
    "bridgeId",
    "publicationDigest",
    "cliExitCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "sw_ab_update_runtime_derived_evidence_producer_bridge_publication_v1" },
    "producerBridgeStatus": { "const": "producer_bridge_present_mechanically_untrusted" },
    "evidenceClass": { "const": "offline_untrusted_runtime_derived_evidence_producer_bridge_candidate" },
    "trustClass": { "const": "untrusted_derived_evidence_producer_bridge_candidate" },
    "status": { "const": "bridge_candidate_not_admitted" },
    "executionAdmission": { "const": "closed_missing_selected_https_origin" },
    "usableForRuntimeEvidence": { "const": false },
    "usableForCandidateAssembly": { "const": false },
    "formalReleaseEvidenceReceipt": { "const": false },
    "strictGatePassed": { "const": false },
    "runtimeAdmissionPassed": { "const": false },
    "admissionPassed": { "const": false },
    "usableForAdmission": { "const": false },
    "publishedAt": { "$ref": "#/$defs/Timestamp" },
    "releaseIdentity": { "$ref": "#/$defs/ReleaseIdentity" },
    "capabilities": { "$ref": "#/$defs/Capabilities" },
    "issuanceBinding": { "$ref": "#/$defs/IssuanceBinding" },
    "transcriptBinding": { "$ref": "#/$defs/TranscriptBinding" },
    "derivedEvidenceBinding": { "$ref": "#/$defs/DerivedEvidenceBinding" },
    "sourceBindings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/SourceBinding" }
    },
    "sourceSetDigest": { "$ref": "#/$defs/Sha256" },
    "publicationBoundary": { "$ref": "#/$defs/PublicationBoundary" },
    "mutationBoundary": { "$ref": "#/$defs/MutationBoundary" },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "authority": { "$ref": "#/$defs/Authority" },
    "attempts": { "$ref": "#/$defs/Attempts" },
    "bridgeId": { "type": "string", "pattern": "^swabpb1-[a-f0-9]{32}$" },
    "publicationDigest": { "$ref": "#/$defs/Sha256" },
    "cliExitCode": { "const": 1 }
  }
}
