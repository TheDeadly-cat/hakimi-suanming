      "properties": {
        "networkObserved": { "const": false },
        "realHostVerified": { "const": false },
        "providerAuthenticated": { "const": false },
        "deploymentOperationObserved": { "const": false },
        "pwaBrowserRuntimeVerified": { "const": false },
        "deployedPwaEngineeringVerified": { "const": false },
        "releaseReady": { "const": false },
        "publicDeploymentAuthorized": { "const": false },
        "publicReleaseAuthorized": { "const": false },
        "contentTruthAuthorized": { "const": false },
        "expertClaimsAuthorized": { "const": false },
        "rightsLegalConclusionAuthorized": { "const": false }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "deployed_pwa_host_provider_composition_candidate_v1" },
    "verificationKind": { "const": "offline-three-independent-candidate-verifiers-v1" },
    "trustClass": { "const": "untrusted_candidate_composition" },
    "status": { "const": "not_admitted" },
    "usableForAdmission": { "const": false },
    "compositionId": {
      "type": "string",
      "pattern": "^hpcomp1-[a-f0-9]{32}$"
    },
    "scope": { "$ref": "#/$defs/Scope" },
    "commonArtifactIdentity": { "$ref": "#/$defs/CommonArtifactIdentity" },
    "packageBindings": { "$ref": "#/$defs/PackageBindings" },
    "sourceBindings": { "$ref": "#/$defs/SourceBindings" },
    "sourceSetDigest": { "$ref": "#/$defs/Sha256" },
